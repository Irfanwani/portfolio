# =============================================================================
#  DEPENDENCIES
# =============================================================================
node_modules/
jspm_packages/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions
bun.lockb
# `bun.lock` and `pnpm-lock.yaml` are intentionally NOT ignored —
# commit the lockfile your package manager generates.

# =============================================================================
#  BUILD OUTPUT
# =============================================================================
dist/
dist-ssr/
build/
out/
.output/
.vercel/
.netlify/
.wrangler/
*.tsbuildinfo
source-map-explorer/

# Vite / framework caches
.vite/
.cache/
.turbo/
.swc/
.temp/
.tmp/

# =============================================================================
#  PRIVATE SOURCE MATERIAL  —  never push to a remote
# =============================================================================
# Official profile export: contains a personal email address and other PII.
# The public site renders this content from src/data/profile.js instead.
# (no local PII files in this repo — see ../portfolio for the resume)
*.pdf
# …but anything deliberately placed under public/ is a site asset — commit it.
!public/**/*.pdf

# Resumes, transcripts, certificates, ID scans
*resume*
*cv*.pdf
*transcript*
*certificate*
*.pfx
*.p12
*.pem
*.key
*.keystore

# =============================================================================
#  SECRETS & ENVIRONMENT
# =============================================================================
.env
.env.*
!.env.example
!.env.template
*.pem
secrets.json
credentials.json
.netrc
.npmrc.local
service-account*.json

# =============================================================================
#  LOGS & DIAGNOSTICS
# =============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.seed
*.pid.lock
*.orig

# =============================================================================
